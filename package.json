{
  "name": "skelet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "9.12.0"
  },
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "start": "pnpm --dir apps/web start",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "test": "node --experimental-strip-types --test \"tests/node/*.test.mjs\" \"apps/web/tests/*.test.mjs\""
  }
}
