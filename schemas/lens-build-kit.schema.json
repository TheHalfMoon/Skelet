{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheHalfMoon/Skelet/schemas/lens-build-kit.schema.json",
  "title": "Skelet Lens Build Kit manifest (frozen v1 contract)",
  "description": "P09b Build Kit manifest and ZIP layout contract. Implementation grains MUST validate kit manifests against this schema before any job logic lands. Unknown-rights bytes MUST NOT enter redistributable artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kit_id",
    "analysis_id",
    "status",
    "lens_report",
    "capture_scope",
    "pages",
    "artifacts",
    "rights_policy",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "skelet.lens.build-kit.v1"},
    "kit_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "analysis_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["queued", "capturing", "extracting", "generating", "validating", "completed", "partial", "failed", "canceled"]},
    "lens_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "analysis_id", "sha256"],
      "properties": {
        "schema": {"const": "skelet.lens.report.v1"},
        "analysis_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "capture_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "max_pages", "max_depth", "max_bytes", "time_budget_ms"],
      "properties": {
        "mode": {"enum": ["single-page", "selected-pages", "bounded-sitemap"]},
        "max_pages": {"type": "integer", "minimum": 1, "maximum": 25},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 52428800},
        "time_budget_ms": {"type": "integer", "minimum": 1000, "maximum": 600000}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {"$ref": "#/$defs/page"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "rights_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_classification", "redistributable_note"],
      "properties": {
        "default_classification": {"enum": ["unknown"]},
        "redistributable_note": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "deterministic", "heuristic", "model_generated", "coverage_gaps", "generated_label"],
      "properties": {
        "observed": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "deterministic": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "heuristic": {"type": "array", "maxItems": 0},
        "model_generated": {"type": "array", "maxItems": 0},
        "coverage_gaps": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "generated_label": {"const": "generated-starter-is-skelet-synthesis-not-original-source"}
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "viewport", "section_refs"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://", "minLength": 1, "maxLength": 2048},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "viewport": {"enum": ["desktop", "mobile"]},
        "section_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "sha256", "bytes", "rights"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"enum": ["manifest", "report", "design-record", "tokens", "theme", "agent-pack", "screenshot", "starter-file", "asset-inventory"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "rights": {"$ref": "#/$defs/rights"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "redistributable"],
      "properties": {
        "classification": {"enum": ["permitted", "unknown", "restricted", "trademarked"]},
        "redistributable": {"type": "boolean"}
      }
    }
  }
}
